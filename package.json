{
  "name": "spacepixelrts",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host --port 5173 --strictPort",
    "build": "tsc --noEmit && vite build && node scripts/gen-desktop.mjs",
    "preview": "vite preview --host --port 4173 --strictPort",
    "deploy": "npm run build && wrangler pages deploy dist --project-name=spacepixelrts",
    "critic": "node scripts/measure.mjs --screenshot critic/out/latest.png",
    "screenshot": "node scripts/screenshot.mjs",
    "test:m0": "tsx tests/app-flow.test.ts",
    "test:m2": "tsx tests/m2-opening.test.ts && tsx tests/m2-discovery.test.ts && tsx tests/m2-guidance.test.ts",
    "qa:m0": "node scripts/qa-m0.mjs",
    "qa:m1": "node scripts/qa-m1.mjs",
    "qa:m2-opening": "node scripts/qa-m2-opening.mjs",
    "qa:m2-discovery": "node scripts/qa-m2-discovery.mjs",
    "qa:m2-guidance": "node scripts/qa-m2-guidance.mjs",
    "qa:m2-ai": "node scripts/qa-m2-ai.mjs",
    "test:vs2b": "tsx tests/vs2b-lumen-field.test.ts",
    "test:vs2-ai": "tsx tests/vs2-ai-doctrine.test.ts",
    "qa:vs2b": "node scripts/qa-vs2b-lumen.mjs",
    "qa:vs2-ai-doctrine": "node scripts/qa-vs2-ai-doctrine.mjs",
    "qa:touch-contract": "node scripts/qa-touch-contract.mjs",
    "qa:progression-handoff": "node scripts/qa-progression-handoff.mjs",
    "test:m2-ai": "tsx tests/m2-ai-knowledge.test.ts",
    "test:m4": "tsx tests/m4-tech-paths.test.ts",
    "test:m5": "tsx tests/m5-army.test.ts",
    "qa:m3-economies": "node scripts/qa-m3-economies.mjs",
    "qa:m4": "node scripts/qa-m4.mjs",
    "test:m3": "tsx tests/m3-economies.test.ts && tsx tests/m3-rigs.test.ts && tsx tests/m3-boosts.test.ts"
  },
  "dependencies": {
    "three": "^0.180.0"
  },
  "devDependencies": {
    "@types/pngjs": "^6.0.5",
    "@types/three": "^0.180.0",
    "playwright": "^1.55.0",
    "pngjs": "^7.0.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "vite": "^7.1.0"
  }
}
