{
  "name": "spacepixelrts",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host --port 5173 --strictPort",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host --port 4173 --strictPort",
    "deploy": "npm run build && wrangler pages deploy dist --project-name=spacepixelrts",
    "critic": "node scripts/measure.mjs --screenshot critic/out/latest.png",
    "screenshot": "node scripts/screenshot.mjs"
  },
  "dependencies": {
    "three": "^0.180.0"
  },
  "devDependencies": {
    "@types/pngjs": "^6.0.5",
    "@types/three": "^0.180.0",
    "playwright": "^1.55.0",
    "pngjs": "^7.0.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "vite": "^7.1.0"
  }
}
